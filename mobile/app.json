{
  "expo": {
    "name": "AZ Zeiterfassung",
    "slug": "drob-labs",
    "scheme": "azzeit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "de.azinnenausbau.zeiterfassung",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "de.azinnenausbau.zeiterfassung",
      "adaptiveIcon": {
        "backgroundColor": "#14181F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "AZ Zeiterfassung braucht Zugriff auf Ihre Fotos, um ein Profilfoto auszuwählen.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#14181F",
          "image": "./assets/splash-icon.png",
          "imageWidth": 220
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "4740579d-36a0-4f7c-9ad7-a003d251dfaa"
      }
    },
    "owner": "drob-labs-team"
  }
}
